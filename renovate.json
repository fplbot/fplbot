{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Oslo",
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Automerge minor/patch updates for every package by default - there's a test env before prod deploy, so this is the default posture; specific rules below override it where a package needs to stay manual (e.g. MassTransit's license-driven major pin)",
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Group xunit packages",
      "matchPackageNames": [
        "xunit",
        "xunit.v3",
        "xunit.runner.visualstudio",
        "xunit.abstractions"
      ],
      "groupName": "xunit",
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Group Microsoft.Extensions.* packages",
      "groupName": "Microsoft.Extensions",
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "/^Microsoft\\.Extensions\\./"
      ]
    },
    {
      "description": "Group Microsoft.AspNetCore.* packages",
      "groupName": "Microsoft.AspNetCore",
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "/^Microsoft\\.AspNetCore\\./"
      ]
    },
    {
      "description": "Group Microsoft.NET.* packages",
      "groupName": "Microsoft.NET",
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "/^Microsoft\\.NET\\./"
      ]
    },
    {
      "description": "Group Serilog packages",
      "groupName": "Serilog",
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "/^Serilog/"
      ]
    },
    {
      "description": "Group MassTransit packages — pin to major 8, skip major bumps",
      "groupName": "MassTransit",
      "automerge": false,
      "allowedVersions": "<9",
      "matchPackageNames": [
        "/^MassTransit/"
      ]
    },
    {
      "description": "Group Slackbot.Net packages - John's own package, safe to automerge",
      "groupName": "Slackbot.Net",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "matchPackageNames": [
        "/^Slackbot\\.Net/"
      ]
    },
    {
      "description": "Group Aspire packages",
      "groupName": "Aspire",
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "/^Aspire\\./",
        "AlmostServiceBus.Aspire.Hosting"
      ]
    },
    {
      "description": "Group Testcontainers packages",
      "groupName": "Testcontainers",
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "/^Testcontainers/"
      ]
    },
    {
      "description": "Group GitHub Actions — actions org",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions (actions/*)",
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "/^actions//"
      ]
    },
    {
      "description": "Group ClientApp npm dependencies",
      "matchManagers": ["npm"],
      "groupName": "ClientApp npm dependencies",
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Pin TypeScript to major 6 — vue-tsc resolves typescript/lib/tsc.js, which TypeScript 7 (the native rewrite) no longer exposes through its package exports, so `npm run typecheck` in client-build dies with ERR_PACKAGE_PATH_NOT_EXPORTED on 7.x. Lift once vue-tsc supports TypeScript 7",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "Never automerge major bumps for any package",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "nuget": {
    "enabled": true
  },
  "ignorePaths": []
}
